{
  "name": "bsc-token",
  "version": "1.0.0",
  "private": true,
  "description": "Independent BNB Smart Chain ERC-20 token. Not Bitcoin, not a Binance-issued asset, and not Bitcoin-backed.",
  "engines": {
    "node": ">=22.21.1 <23"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "lint": "eslint . && solhint \"contracts/**/*.sol\"",
    "lint:ts": "eslint .",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "security:check": "bash scripts/security-check.sh",
    "typecheck": "tsc --noEmit",
    "deploy:local": "hardhat run scripts/deploy-token.ts --network hardhat",
    "deploy:localhost": "hardhat run scripts/deploy-token.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy-token.ts --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy-token.ts --network bsc",
    "deploy:implementation": "hardhat run scripts/deploy-implementation.ts",
    "deploy:proxy": "hardhat run scripts/deploy-proxy.ts",
    "verify:testnet": "hardhat run scripts/verify-contract.ts --network bscTestnet",
    "verify:mainnet": "hardhat run scripts/verify-contract.ts --network bsc",
    "inspect:localhost": "hardhat run scripts/inspect-token.ts --network localhost",
    "inspect:testnet": "hardhat run scripts/inspect-token.ts --network bscTestnet",
    "inspect:mainnet": "hardhat run scripts/inspect-token.ts --network bsc",
    "constraints:remove:localhost": "hardhat run scripts/remove-transfer-constraints.ts --network localhost",
    "constraints:remove:testnet": "hardhat run scripts/remove-transfer-constraints.ts --network bscTestnet",
    "constraints:remove:mainnet": "hardhat run scripts/remove-transfer-constraints.ts --network bsc",
    "liquidity:add:mainnet": "hardhat run scripts/add-liquidity.ts --network bsc",
    "liquidity:remove:mainnet": "hardhat run scripts/remove-liquidity.ts --network bsc",
    "swap:mainnet": "hardhat run scripts/swap-token.ts --network bsc",
    "token:transfer:mainnet": "hardhat run scripts/transfer-token.ts --network bsc",
    "ownership:transfer:mainnet": "hardhat run scripts/transfer-ownership.ts --network bsc",
    "ownership:renounce:mainnet": "hardhat run scripts/renounce-ownership.ts --network bsc",
    "proxy:upgrade:mainnet": "hardhat run scripts/upgrade-proxy.ts --network bsc",
    "balance:mainnet": "hardhat run scripts/balance-token.ts --network bsc",
    "supply:mainnet": "hardhat run scripts/supply-token.ts --network bsc",
    "allowance:mainnet": "hardhat run scripts/allowance-token.ts --network bsc",
    "approval:revoke:mainnet": "hardhat run scripts/revoke-approval.ts --network bsc",
    "liquidity:lock:mainnet": "hardhat run scripts/lock-liquidity.ts --network bsc",
    "liquidity:inspect:mainnet": "hardhat run scripts/inspect-liquidity-lock.ts --network bsc",
    "token:burn:mainnet": "hardhat run scripts/burn-token.ts --network bsc",
    "pause:mainnet": "PAUSE_ACTION=pause hardhat run scripts/pause-token.ts --network bsc",
    "unpause:mainnet": "PAUSE_ACTION=unpause hardhat run scripts/pause-token.ts --network bsc"
  },
  "dependencies": {
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-upgradeable": "4.9.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@openzeppelin/hardhat-upgrades": "3.9.1",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.19.21",
    "chai": "4.5.0",
    "dotenv": "16.6.1",
    "eslint": "9.39.5",
    "ethers": "6.15.0",
    "hardhat": "2.29.1",
    "solhint": "5.2.0",
    "solidity-coverage": "0.8.17",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  }
}
