{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "dist",
    "types": ["node", "mocha"]
  },
  "include": [
    "hardhat.config.ts",
    "config/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "types/**/*.ts"
  ]
}
