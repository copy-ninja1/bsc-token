# Deployment signer. 32-byte hex, with or without 0x.
# Never commit a real key. Use a dedicated wallet funded only for deployment.
PRIVATE_KEY=

# RPC endpoints. Required for testnet and mainnet deployments.
# Official public endpoints are documented in docs/DEPLOYMENT.md.
# Do not rely on a hidden fallback for a real deployment.
BSC_TESTNET_RPC_URL=
BSC_MAINNET_RPC_URL=

# Etherscan API key with BNB Smart Chain access (Etherscan API v2).
# Verification is optional and is never claimed unless the verify script succeeds.
BSCSCAN_API_KEY=

# Token settings. Decimals are fixed at 18 by the contract.
TOKEN_NAME=BTC Token
TOKEN_SYMBOL=BTC
TOKEN_DECIMALS=18
TOKEN_INITIAL_SUPPLY=1000000000
TOKEN_METADATA_URI=

# Both addresses must be the wallet that sends the initialization transaction.
# The contract assigns ownership to that caller and mints the supply to that caller.
INITIAL_OWNER=
INITIAL_SUPPLY_RECIPIENT=

# Predicted or deployed pool addresses. They are not inferred.
# While transfer constraints are enabled, transfers to or from these addresses revert.
UNISWAP_V2_POOL_ADDRESS=
UNISWAP_V3_POOL_ADDRESS=

# Optional overrides for inspect, verify, and the split deployment scripts.
TOKEN_ADDRESS=
IMPLEMENTATION_ADDRESS=

# Public deployment safety. Local Hardhat deployment does not use these flags.
CONFIRM_TESTNET_DEPLOYMENT=false
CONFIRM_MAINNET_DEPLOYMENT=false
# Interactive prompts ask you to type DEPLOY. Set this only for a non-interactive shell.
DEPLOY_CONFIRMATION=
# Separate confirmation for permanently removing pool transfer constraints.
CONFIRM_REMOVE_CONSTRAINTS=false
# Separate confirmation for the PancakeSwap liquidity command. This spends the token and the quote asset.
CONFIRM_ADD_LIQUIDITY=false
# Human amounts for npm run liquidity:add:mainnet. The ratio is the opening price.
# QUOTE_TOKEN defaults to Binance-Peg BTCB on mainnet. Set it only to choose a different quote asset.
LIQUIDITY_TOKEN_AMOUNT=
LIQUIDITY_QUOTE_AMOUNT=
# Optional. Basis points, 100 = 1%. Maximum 1000. Defaults to 100.
# Used by add liquidity, remove liquidity, and swap.
LIQUIDITY_SLIPPAGE_BPS=
QUOTE_TOKEN=
# Remove liquidity. Empty or max withdraws the signer's whole LP balance.
CONFIRM_REMOVE_LIQUIDITY=false
LIQUIDITY_LP_AMOUNT=
# One PancakeSwap swap. Set SWAP_QUOTE_AMOUNT (or SWAP_BTCB_AMOUNT) or SWAP_TOKEN_AMOUNT, not both.
CONFIRM_SWAP=false
SWAP_QUOTE_AMOUNT=
SWAP_BTCB_AMOUNT=
SWAP_TOKEN_AMOUNT=
# Send tokens from the signer.
CONFIRM_TRANSFER=false
TRANSFER_TO=
TRANSFER_AMOUNT=
# Token owner changes. Renounce cannot be undone.
CONFIRM_TRANSFER_OWNERSHIP=false
NEW_OWNER=
CONFIRM_RENOUNCE_OWNERSHIP=false
# Proxy admin upgrade. The first matching run only records the storage layout.
CONFIRM_UPGRADE=false
# Read a wallet balance. Defaults to the signer when PRIVATE_KEY is set.
BALANCE_ACCOUNT=
# Read an allowance. SPENDER is required. ALLOWANCE_OWNER defaults to the signer.
SPENDER=
ALLOWANCE_OWNER=
# Set that allowance to zero. Only the wallet that granted it can revoke it.
CONFIRM_REVOKE_APPROVAL=false
# PinkLock V2 LP lock. Set LOCK_DAYS or LOCK_UNLOCK_AT, not both.
# LIQUIDITY_LP_AMOUNT empty withdraws or locks the signer's whole LP balance.
CONFIRM_LOCK_LIQUIDITY=false
LOCK_DAYS=
LOCK_UNLOCK_AT=
LOCK_DESCRIPTION=
LOCK_ID=
LOCK_OWNER=
LOCK_CONTRACT=
# Burn and pause run only when the current implementation has those functions.
CONFIRM_BURN=false
BURN_AMOUNT=
CONFIRM_PAUSE=false
CONFIRM_UNPAUSE=false
# Set to true only when you intentionally want another deployment record on that network.
ALLOW_REDEPLOY=false
